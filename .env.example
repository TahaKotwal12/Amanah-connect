# Copy to .env and fill in. NEVER commit a real .env (it is gitignored).
# The backend reads these from the process environment; Spring does not load .env files by itself.
# Load them in your shell first:   set -a; source .env; set +a

# --- Profile ---------------------------------------------------------------------------------
# local | prod   (tests set "test" themselves)
SPRING_PROFILES_ACTIVE=local

# --- Application database (Neon POOLED endpoint: host contains "-pooler") ---------------------
# JDBC does NOT accept user:password@ in the URL and Neon's "channel_binding" parameter is not
# supported by the driver. Credentials go in the two variables below, never in the URL.
DB_URL=jdbc:postgresql://ep-example-123456-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DB_USER=
DB_PASSWORD=

# --- Flyway migrations (Neon DIRECT endpoint: same host WITHOUT "-pooler") --------------------
# Flyway's advisory lock does not work through PgBouncer transaction pooling.
FLYWAY_URL=jdbc:postgresql://ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=require
FLYWAY_USER=
FLYWAY_PASSWORD=

# --- Mail (prod). Local uses Mailpit on localhost:1025 and needs none of these ----------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# --- Authentication secrets (REQUIRED outside the local/test profiles) -------------------------
# JWT signing secret, at least 32 bytes:      openssl rand -base64 48
JWT_SECRET=
# AES-256 key that encrypts 2FA secrets at rest, base64 of 32 bytes:   openssl rand -base64 32
# Changing it later makes every enrolled 2FA secret unreadable, so treat it like a database password.
TOTP_ENC_KEY=

# --- Browser origin allowed to call the API (comma separated for several) ----------------------
# Also the only Origin accepted on the cookie endpoints (/auth/refresh, /auth/logout).
ALLOWED_ORIGIN=http://localhost:5173
# Base URL used in the links of reset-password and invitation emails.
FRONTEND_BASE_URL=http://localhost:5173

# --- First super admin (first start ONLY) ------------------------------------------------------
# Created only if no SUPER_ADMIN exists. The account must enrol in 2FA at its first login.
# REMOVE BOTH LINES after the first start: they are ignored once a super admin exists, but a
# password in an env file is still a password in a file.
# BOOTSTRAP_SUPERADMIN_EMAIL=
# BOOTSTRAP_SUPERADMIN_PASSWORD=

# --- Platform administration -------------------------------------------------------------------
# Where "new lead" notifications go. Blank = every active SUPER_ADMIN.
# PLATFORM_NOTIFICATION_EMAIL=
# Daily subscription job (09:00 IST) always warns owners 7 and 1 days before expiry and marks lapsed
# subscriptions EXPIRED. It NEVER suspends a community unless you switch this on deliberately:
# APP_SUBSCRIPTIONS_AUTO_SUSPEND_ENABLED=false
# APP_SUBSCRIPTIONS_GRACE_DAYS=7
# APP_SUBSCRIPTIONS_EXPIRING_WINDOW_DAYS=30
# Set to false on all but the instance that should run scheduled jobs (ShedLock also guards against double runs).
# APP_SCHEDULING_ENABLED=true
# CSV import limits per file.
# APP_IMPORTS_MAX_ROWS_PER_FILE=5000
# APP_IMPORTS_MAX_FILE_BYTES=2097152

# --- Email (Amazon SES over SMTP) -------------------------------------------------------------
# MAIL_HOST=email-smtp.ap-south-1.amazonaws.com
# MAIL_PORT=587
# MAIL_USER=             # SES SMTP credentials (not your AWS keys)
# MAIL_PASSWORD=
# The From address; its domain must be verified in SES. Member mail shows "<Community> via Amanah Connect".
# MAIL_FROM=Amanah Connect <no-reply@your-domain>
# Bounce/complaint webhook: SNS topic(s) whose notifications are accepted (comma separated) and the SES configuration set.
# SES_SNS_TOPIC_ARNS=arn:aws:sns:ap-south-1:123456789012:amanah-ses-events
# SES_CONFIGURATION_SET=
# APP_EMAIL_PREVIEW_ENABLED=false   # super admin template preview: local and staging only, never production

# --- File storage (logos, attachments, receipt PDFs) ----------------------------------------------
# Private S3 bucket. Files are uploaded straight from the browser with a signed URL and shown with
# short-lived signed URLs, so the bucket never needs to be public. Leave empty to run without it
# (logo upload then answers 503). On EC2 use an instance role; no access keys in this file.
# S3_BUCKET=
# AWS_REGION=ap-south-1
# S3_ENDPOINT=            # only for MinIO / LocalStack (the local profile uses MinIO from docker-compose.local.yml)
# S3_ACCESS_KEY=          # only for MinIO; on AWS leave empty and use the instance role
# S3_SECRET_KEY=
# APP_STORAGE_LOGO_MAX_BYTES=524288
# Ledger attachments (receipts and PDFs are stored in the same bucket).
# APP_STORAGE_ATTACHMENT_MAX_BYTES=5242880

# --- Support chat ---------------------------------------------------------------------------
# A burst of chat messages sends one email; messages still unread are re-mailed after this many minutes.
# APP_SUPPORT_EMAIL_REMINDER_MINUTES=30

# --- Billing ----------------------------------------------------------------------------------
# How many days a payment link in a bill email keeps working.
# APP_BILLING_PAY_LINK_DAYS=60
# Most invoices a single generate call may create.
# APP_BILLING_GENERATION_MAX_MEMBERS=5000

# --- Local docker-compose only ----------------------------------------------------------------
# LOCAL_POSTGRES_PASSWORD=amanah_local_only

# ---- read side: dashboard, audit, data export ----
# APP_DASHBOARD_CACHE_SECONDS=30     # how long one community's dashboard is reused (Caffeine, in memory)
# APP_DASHBOARD_UPCOMING_DAYS=14     # "falls due soon" window
# APP_AUDIT_EXPORT_LIMIT=100000      # most rows in one audit CSV export
# APP_EXPORTS_LINK_VALIDITY=PT48H    # how long the emailed data-export link works (the ZIP is deleted afterwards)
# APP_EXPORTS_MAX_PER_DAY=3          # data exports per community per 24 hours
# APP_EXPORTS_LINK_BASE_URL=         # public site the emailed link points to; empty uses the frontend URL
