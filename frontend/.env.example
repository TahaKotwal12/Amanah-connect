# Copy to .env.local for local overrides. Only VITE_* values reach the browser: never put secrets here.

# Where `vite dev` and `vite preview` forward /api/* (the Spring Boot API).
# In production Nginx serves the SPA and proxies /api/v1 on the same origin, so the app keeps using the
# relative base path and no CORS or cross-site cookie setup is needed.
VITE_API_URL=http://localhost:8080

# Used only by `npm run gen:api` (springdoc is enabled in the local profile only).
# OPENAPI_URL=http://localhost:8080/v3/api-docs

# Public address of the site, no trailing slash. Needed at build time for the canonical link, og:image,
# JSON-LD url, sitemap.xml and the robots.txt Sitemap line. Leave unset until the domain exists.
# VITE_SITE_URL=https://example.com
