# Copy to ~/amanah/.env ON THE SERVER and fill in. Never commit the filled-in file.
# Lock it down:  chmod 600 ~/amanah/.env

DOMAIN=uat.amanahconnect.co.in
ALLOWED_ORIGIN=https://uat.amanahconnect.co.in
FRONTEND_BASE_URL=https://uat.amanahconnect.co.in

# --- Neon. Use a NEW project for UAT (see the deploy notes). Credentials go in the two variables,
# never inside the URL.
DB_URL=jdbc:postgresql://<pooled-host>/neondb?sslmode=require
DB_USER=
DB_PASSWORD=
# Direct endpoint = the same host WITHOUT "-pooler".
FLYWAY_URL=jdbc:postgresql://<direct-host>/neondb?sslmode=require
FLYWAY_USER=
FLYWAY_PASSWORD=

# --- Secrets. Generate on the server:  openssl rand -base64 48   /   openssl rand -base64 32
JWT_SECRET=
TOTP_ENC_KEY=
STORAGE_SIGNING_KEY=

# --- Mail (Hostinger). The sender must be the mailbox itself.
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SSL=true
MAIL_STARTTLS=false
MAIL_USER=taha@amanahconnect.co.in
MAIL_PASSWORD=
MAIL_FROM=Amanah Connect <taha@amanahconnect.co.in>

# --- First super admin. Needed for the FIRST start only: delete both lines afterwards.
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# Phase 1 is cash only.
UPI_ENABLED=false
