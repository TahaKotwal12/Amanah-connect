# Built on the server by docker compose. Java and Maven live inside this build, not on the host.
# Build context is the repository root.
FROM eclipse-temurin:21-jdk-alpine AS build
WORKDIR /src
COPY backend/mvnw backend/pom.xml ./
COPY backend/.mvn .mvn
# A 2 GB server: keep Maven's own memory modest.
ENV MAVEN_OPTS="-Xmx700m"
RUN --mount=type=cache,target=/root/.m2 sed -i 's/\r$//' mvnw && chmod +x mvnw && ./mvnw -q -B dependency:go-offline
COPY backend/src src
RUN --mount=type=cache,target=/root/.m2 ./mvnw -q -B package -DskipTests \
 && cp target/*.jar /app.jar

FROM eclipse-temurin:21-jre-alpine
RUN addgroup -S -g 1000 app && adduser -S -u 1000 -G app app \
 && mkdir -p /data/files && chown app:app /data/files
USER app
WORKDIR /app
COPY --from=build /app.jar /app/app.jar
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=55 -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Kolkata"
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
